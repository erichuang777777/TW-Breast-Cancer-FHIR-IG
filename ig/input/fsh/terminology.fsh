CodeSystem: QBCFieldCodeSystem
Id: qbc-field
Title: "QBC XML Field Codes"
Description: "非官方 QBC XML 欄位代碼彙整。代碼用於保存來源欄位，不取代健保署公布之申報規格。"
* ^url = $QBCFieldCS
* ^status = #draft
* ^experimental = true
* ^caseSensitive = true
* ^content = #complete
* #HOSPID "醫事機構代號"
* #ID "個案身分識別碼"
* #BIRTHDAY "個案出生年月日"
* #DIAG_TYPE "收案類別"
* #LATERALITY "側性（患部）"
* #P01 "個案姓名"
* #P02 "個案性別"
* #P03 "身高"
* #P04 "體重"
* #P05 "是否已停經"
* #P06 "停經年齡"
* #P07 "主責醫師身分識別碼"
* #P08 "個案分類"
* #P09 "收案日期"
* #D001 "（新輔助）最初診斷日期"
* #D002 "（新輔助）最初診斷院所"
* #D003 "（新輔助）組織學分類"
* #D004 "（新輔助）腫瘤組織分級"
* #D005 "（新輔助）臨床期別 T"
* #D006 "（新輔助）臨床期別 N"
* #D007 "（新輔助）臨床期別 M"
* #D008 "（新輔助）癌症臨床分期 TNM 計算結果"
* #D009 "（新輔助）遠端轉移部位"
* #D010 "（新輔助）遠端轉移部位：其他"
* #D011 "（新輔助）術前腋下淋巴檢驗：未檢驗"
* #D012 "（新輔助）術前腋下淋巴檢驗：檢驗方式"
* #D013 "（新輔助）術前腋下淋巴檢驗：檢驗結果"
* #D014 "（新輔助）ER"
* #D015 "（新輔助）ER 數值"
* #D016 "（新輔助）PR"
* #D017 "（新輔助）PR 數值"
