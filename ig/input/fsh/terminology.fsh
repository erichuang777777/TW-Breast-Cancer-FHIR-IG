ValueSet: QBCFieldValueSet
Id: qbc-field
Title: "QBC XML Field Value Set"
Description: "本非官方草案收錄的 QBC XML 欄位代碼。"
* ^status = #draft
* ^experimental = true
* include codes from system QBCFieldCodeSystem

ValueSet: QBCDateFieldValueSet
Id: qbc-date-field
Title: "QBC Date Field Value Set"
Description: "主表格式為固定 8 碼 YYYYMMDD、可安全轉成 FHIR dateTime 的全部 QBC 日期欄位。不含 `BIRTHDAY`：出生日期在本 IG 以 `QBCPatient.birthDate` 表示，不重複建立 Observation。"
* ^status = #draft
* ^experimental = true
// 診斷日期
* $QBCFieldCS#D001
* $QBCFieldCS#D025
* $QBCFieldCS#D058
// 收案日期
* $QBCFieldCS#P09
// 治療療程起訖
* $QBCFieldCS#TM09
* $QBCFieldCS#TM10
// 追蹤、轉出、結案與死亡
* $QBCFieldCS#T01
* $QBCFieldCS#T04
* $QBCFieldCS#T05
* $QBCFieldCS#T06

ValueSet: QBCIntegerFieldValueSet
Id: qbc-integer-field
Title: "QBC Integer Field Value Set"
Description: "主表格式為整數、可安全轉成 FHIR integer 的全部 QBC 欄位：停經年齡、生物標記整數百分比、淋巴結計數與治療順序。"
* ^status = #draft
* ^experimental = true
* $QBCFieldCS#P06
* $QBCFieldCS#TM01
* $QBCFieldCS#D015
* $QBCFieldCS#D017
* $QBCFieldCS#D021
* $QBCFieldCS#D039
* $QBCFieldCS#D040
* $QBCFieldCS#D042
* $QBCFieldCS#D043
* $QBCFieldCS#D045
* $QBCFieldCS#D046
* $QBCFieldCS#D049
* $QBCFieldCS#D051
* $QBCFieldCS#D055
* $QBCFieldCS#D071
* $QBCFieldCS#D072
* $QBCFieldCS#D074
* $QBCFieldCS#D075
* $QBCFieldCS#D077
* $QBCFieldCS#D079
* $QBCFieldCS#D083

Instance: QBCBundleIdentifierNamingSystem
InstanceOf: NamingSystem
Usage: #definition
Title: "QBC Submission Bundle Identifier"
Description: "本 IG 為 QBC Submission Bundle 識別碼所定義的命名空間。"
* name = "QBCSubmissionBundleIdentifier"
* status = #draft
* kind = #identifier
* date = "2026-08-13"
* publisher = "QBC IG Community Draft"
* responsible = "QBC IG Community Draft"
* description = "非官方 QBC 草案用來識別單一 Submission Bundle 的 identifier 命名空間。識別碼值由送件端自行決定，須在該送件端範圍內唯一，且不得包含個案身分識別資訊。"
* jurisdiction = urn:iso:std:iso:3166#TW
* uniqueId.type = #uri
* uniqueId.value = "https://erichuang777777.github.io/TW-Breast-Cancer-FHIR-IG/sid/qbc-bundle-id"
* uniqueId.preferred = true

Instance: CancerCarePlanBundleIdentifierNamingSystem
InstanceOf: NamingSystem
Usage: #definition
Title: "Cancer Care Plan Task Bundle Identifier"
Description: "本 IG 為癌症診療計畫書 Task Bundle 識別碼所定義的命名空間。"
* name = "CancerCarePlanTaskBundleIdentifier"
* status = #draft
* kind = #identifier
* date = "2026-08-15"
* publisher = "Breast Cancer FHIR Community Draft"
* responsible = "Breast Cancer FHIR Community Draft"
* description = "非官方社群草案用來識別單一癌症診療計畫書 Task Bundle 的命名空間。識別碼由產生端決定，須在該端範圍內唯一，且公開範例不得包含個案識別資訊。"
* jurisdiction = urn:iso:std:iso:3166#TW
* uniqueId.type = #uri
* uniqueId.value = "https://erichuang777777.github.io/TW-Breast-Cancer-FHIR-IG/sid/cancer-care-plan-bundle-id"
* uniqueId.preferred = true

ValueSet: QBCQuantityFieldValueSet
Id: qbc-quantity-field
Title: "QBC Quantity Field Value Set"
Description: "主表格式為含小數的量測值、應以 UCUM 單位表示的 QBC 欄位：身高、體重與手術時顯微鏡下腫瘤大小。"
* ^status = #draft
* ^experimental = true
* $QBCFieldCS#P03
* $QBCFieldCS#P04
* $QBCFieldCS#D047
