# ---------------------------------------------------------------------------
# 1. 病人資料 / PHI — 絕對不可進入版本控制或任何發布物
# ---------------------------------------------------------------------------
# 受控隔離目錄：所有真實個案、名單、病歷來源檔一律放這裡
private/
patients/
incoming/

# 防呆：即使檔案被誤放回專案根目錄也一併排除
EligibleList*.xls*
*新診斷及測試名單*.xls*
*名單*.xls*
test_case.xlsx
runtime/
outputs/source_audit/extracted/
outputs/source_audit/source_line_traceability.csv

# ---------------------------------------------------------------------------
# 2. 第三方著作 — 健保署／衛福部原始規格文件，不得由本專案再散布
# ---------------------------------------------------------------------------
*.pdf
*.docx
*.doc
~$*

# ---------------------------------------------------------------------------
# 3. Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
tmp/
*.log
.env
config/*.env
!config/example.env

# ---------------------------------------------------------------------------
# 4. IG 建置產物與工具鏈（不屬於發布原始碼）
# ---------------------------------------------------------------------------
ig/publisher.jar
ig/output/
ig/temp/
ig/template/
ig/fsh-generated/
ig/.fhir/
ig/input-cache/
ig/tools/node_modules/
ig/tools/rubyinstaller.7z
ig/tools/ruby/
ig/tools/gems/
ig/tools/*.gem
ig/tools/*-build-stub/*.gem
.npm-cache/
.omc/

# ---------------------------------------------------------------------------
# 5. 打包輸出 — 全部可由 scripts/build_release.py 從工作樹重建
# ---------------------------------------------------------------------------
release/
